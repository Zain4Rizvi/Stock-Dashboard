# Copy to .env.local. Next.js reads .env.local, then .env. Never prefix these with NEXT_PUBLIC_.

# Market data adapter. seed stays offline on the demo snapshot.
# yahoo is unofficial and for development only.
# Allowed: seed | yahoo | fmp | twelvedata | alphavantage
MARKET_DATA_PROVIDER=seed

FMP_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# LLM adapter. template needs no key and never calls the network.
# Allowed: template | groq
# GROQ_API_KEY is a server secret. next dev reads it from the environment.
# On Cloudflare, set it as a Worker runtime secret. Do not put it in wrangler.jsonc vars
# and do not prefix it with NEXT_PUBLIC_. Deploy from a tree without a .env file,
# and pass --keep-vars so that secret stays on the Worker.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Optional. Unset uses openai/gpt-oss-120b.
LLM_MODEL=openai/gpt-oss-120b

# Cache driver. file is memory in front of .cache/market (dev).
# kv uses the MARKET_KV binding on the Cloudflare Worker. The daily cron writes that store.
# Allowed: file | memory | kv
CACHE_DRIVER=file
