# Copy to .env.local. Next.js reads .env.local, then .env. Never prefix these with NEXT_PUBLIC_.

# Market data adapter. seed stays offline on the demo snapshot.
# yahoo is unofficial and for development only.
# Allowed: seed | yahoo | fmp | twelvedata | alphavantage
MARKET_DATA_PROVIDER=seed

FMP_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# LLM adapter. template needs no key and never calls the network.
# Allowed: template | groq
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Cache driver. file is memory in front of .cache/market (dev). Swap later for Redis/KV.
# Allowed: file | memory
CACHE_DRIVER=file
